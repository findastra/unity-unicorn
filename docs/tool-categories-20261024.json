{
  "schema": "unity-unicorn.tool-categories/v1",
  "updated": "2026-10-24",
  "about": "How Unity Unicorn's tools are named, and the category of every tool the page lists. Astra, 2026-10-24: \"its a spawner if it makes 3D objects, its a painter if it changes existing object surfaces\". Her tools pipe-spawn, vine-spawn, bubble-spawn, glitter-spawn, marble-carver and crystal-reflection-painter show the naming: what it works on, then the category's word.",
  "naming": "<what-it-works-on>-<category word>, lowercase with hyphens: pipe-spawn, vine-spawn, crystal-reflection-painter, marble-carver. New tools are named this way. Tools that already exist keep their names until Astra says to rename them.",
  "colors": "Astra, 2026-10-24: the colours run like a rainbow, red to purple, then pink: from the tools that change the most to the ones that change nothing. A tool that does two or three jobs is drawn in two or three colours, its main job first (the main job gives its name).",
  "order": "Astra, 2026-10-24 (all recommended): inside each colour, related tools sit side by side (groups in the order below), A to Z by new name inside each group.",
  "categories": [
    {
      "id": "spawner",
      "word": "spawn",
      "from": "Astra",
      "means": "Makes new 3D objects.",
      "example": "vine-spawn",
      "color": "#ff4d4d",
      "color_name": "red",
      "family": "Warm: changes objects"
    },
    {
      "id": "carver",
      "word": "carver",
      "from": "proposed",
      "means": "Changes the shape, weights or placement of objects that already exist.",
      "example": "marble-carver",
      "color": "#ff8a2b",
      "color_name": "orange",
      "family": "Warm: changes objects"
    },
    {
      "id": "painter",
      "word": "painter",
      "from": "Astra",
      "means": "Changes the surfaces of objects that already exist: colours, textures, materials and shaders.",
      "example": "crystal-reflection-painter",
      "color": "#ffe14d",
      "color_name": "yellow",
      "family": "Warm: changes objects"
    },
    {
      "id": "strapper",
      "word": "strapper",
      "from": "proposed",
      "means": "Puts a ready-made add-on onto an avatar: wings, bending, sparks, a face tracking module.",
      "example": "wing-strapper",
      "color": "#4dff7a",
      "color_name": "green",
      "family": "Green: adds onto things"
    },
    {
      "id": "mover",
      "word": "mover",
      "from": "proposed",
      "means": "Makes things move or react in the world while people play (Udon).",
      "example": "door-system",
      "color": "#2bf5d0",
      "color_name": "teal",
      "family": "Green: adds onto things"
    },
    {
      "id": "builder",
      "word": "builder",
      "from": "proposed",
      "means": "Puts pieces together into a scene, a stop, a test build or a bake.",
      "example": "stop-01-builder",
      "color": "#3da5ff",
      "color_name": "blue",
      "family": "Blue: assembles"
    },
    {
      "id": "checker",
      "word": "checker",
      "from": "proposed",
      "means": "Looks and reports; changes nothing.",
      "example": "world-validator",
      "color": "#6e6bff",
      "color_name": "indigo",
      "family": "Purple: only looks"
    },
    {
      "id": "viewer",
      "word": "viewer",
      "from": "proposed",
      "means": "Makes pictures for review: renders, previews, contact sheets and photos.",
      "example": "review-shots",
      "color": "#b26bff",
      "color_name": "violet",
      "family": "Purple: only looks"
    },
    {
      "id": "keeper",
      "word": "keeper",
      "from": "proposed",
      "means": "Keeps records and libraries: where things came from, what was made, what is installed.",
      "example": "asset-ledger",
      "color": "#ff8fdc",
      "color_name": "light pink",
      "family": "Pink: tools about tools"
    },
    {
      "id": "runner",
      "word": "runner",
      "from": "proposed",
      "means": "Runs other tools or walks a list of steps.",
      "example": "run-unity-tool",
      "color": "#ff3db8",
      "color_name": "hot pink",
      "family": "Pink: tools about tools"
    }
  ],
