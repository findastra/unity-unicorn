  "schema": "unity-unicorn.tool-categories/v1",
  "updated": "2026-10-24",
  "about": "How Unity Unicorn's tools are named, and the category of every tool the page lists. Astra, 2026-10-24: \"its a spawner if it makes 3D objects, its a painter if it changes existing object surfaces\". Her tools pipe-spawn, vine-spawn, bubble-spawn, glitter-spawn, marble-carver and crystal-reflection-painter show the naming: what it works on, then the category's word.",
  "naming": "<what-it-works-on>-<category word>, lowercase with hyphens: pipe-spawn, vine-spawn, crystal-reflection-painter, marble-carver. New tools are named this way. Tools that already exist keep their names until Astra says to rename them.",
  "categories": [
    { "id": "spawner", "word": "spawn", "from": "Astra", "means": "Makes new 3D objects.", "example": "vine-spawn" },
    { "id": "painter", "word": "painter", "from": "Astra", "means": "Changes the surfaces of objects that already exist: colours, textures, materials and shaders.", "example": "crystal-reflection-painter" },
    { "id": "carver", "word": "carver", "from": "proposed", "means": "Changes the shape, weights or placement of objects that already exist.", "example": "marble-carver" },
    { "id": "strapper", "word": "strapper", "from": "proposed", "means": "Puts a ready-made add-on onto an avatar: wings, bending, sparks, a face tracking module.", "example": "wing-strapper" },
    { "id": "builder", "word": "builder", "from": "proposed", "means": "Puts pieces together into a scene, a stop, a test build or a bake.", "example": "stop-01-builder" },
    { "id": "mover", "word": "mover", "from": "proposed", "means": "Makes things move or react in the world while people play (Udon).", "example": "door-system" },
    { "id": "checker", "word": "checker", "from": "proposed", "means": "Looks and reports; changes nothing.", "example": "world-validator" },
    { "id": "viewer", "word": "viewer", "from": "proposed", "means": "Makes pictures for review: renders, previews, contact sheets and photos.", "example": "review-shots" },
    { "id": "keeper", "word": "keeper", "from": "proposed", "means": "Keeps records and libraries: where things came from, what was made, what is installed.", "example": "asset-ledger" },
    { "id": "runner", "word": "runner", "from": "proposed", "means": "Runs other tools or walks a list of steps.", "example": "run-unity-tool" }
  ],
